# Copy into Dokploy > cita-bot > Environment. Fill every CHANGE_ME.

# --- Who you are (required) ---
NAME=CHANGE_ME_FULL_NAME_AS_ON_DOCUMENT
DOC_TYPE=NIE
DOC_VALUE=CHANGE_ME_X1234567Z
COUNTRY=RUSIA
YEAR_OF_BIRTH=
PHONE=CHANGE_ME_600000000
EMAIL=CHANGE_ME@example.com

# --- What to book ---
PROVINCE=BARCELONA
OPERATION=TOMA_HUELLAS
# Comma-separated Office names, in order of preference. Empty = any office.
OFFICES=
EXCEPT_OFFICES=
# dd/mm/yyyy and hh:mm, all optional
MIN_DATE=
MAX_DATE=
MIN_TIME=
MAX_TIME=

# --- Full automation ---
# Leave ANTICAPTCHA_API_KEY=CHANGE_ME to run in ALERT-ONLY mode: the bot just polls and posts
# to Discord when appointments look available, and never books. With a real key it books
# automatically, and then SMS_WEBHOOK_TOKEN is required too.
ANTICAPTCHA_API_KEY=CHANGE_ME
SMS_WEBHOOK_TOKEN=CHANGE_ME

# --- Discord ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME
# Optional ping on important events, e.g. <@123456789012345678>
DISCORD_MENTION=

# --- Network ---
# The ICP site drops connections from IPs outside Spain and from many datacenters. If the logs
# show "[net] TCP ... failed", run on a Spanish IP or route Chrome through a Spanish proxy.
# Chrome cannot send proxy credentials, so use an IP-whitelisted proxy or an unauthenticated
# one on a private network, e.g. socks5://10.0.0.5:1080
PROXY_SERVER=

# --- Tuning ---
# Attempts per browser session before starting a fresh browser
SESSION_CYCLES=200
# Seconds to wait between browser sessions
RETRY_DELAY=30
# Discord "still searching" status every N attempts (0 = never)
HEARTBEAT_CYCLES=100
